{
  "manifest_version": 3,
  "name": "YouTube Music Only",
  "version": "1.0.0",
  "description": "Toggle YouTube Music without interrupting videos in other tabs.",
  "permissions": ["scripting", "nativeMessaging"],
  "key": "",
  "host_permissions": ["https://music.youtube.com/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Play / pause YouTube Music only (Win+Shift+K)"}
}
